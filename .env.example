PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
# Generate a long random secret; production requires at least 32 characters.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Bootstrap admin only on first run. Use a unique password with 14+ characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-14-chars-min
# Obtain these from Stripe Dashboard. Never expose secret keys in browser code.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Optional path; data is ignored by git.
DB_FILE=data/nexora.sqlite
